@model IReadOnlyList<BookStore.Dtos.Common.AboutDto>
@{
    ViewData["Title"] = "Quản Lý Giới Thiệu & Tin Tức";
    ViewData["BreadcrumbParent"] = "Quản Lý";
    string? search = ViewData["Search"]?.ToString();
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h4 class="mb-0 fw-600" style="font-size:1.15rem;color:#262626">Quản Lý Giới Thiệu &amp; Tin Tức</h4>
        <p class="text-muted mb-0" style="font-size:.85rem">Quản lý nội dung giới thiệu và bài viết tin tức</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" asp-controller="About" target="_blank"
           class="btn btn-outline-secondary btn-sm" style="border-radius:6px;font-size:.875rem;padding:7px 16px">
            <i class="bi bi-eye me-1"></i>Xem trang công khai
        </a>
        <a asp-action="Create"
           class="btn btn-primary btn-sm" style="border-radius:6px;font-size:.875rem;padding:7px 16px">
            <i class="bi bi-plus-lg me-1"></i>Thêm Mới
        </a>
    </div>
</div>

<!-- Bộ lọc -->
<div class="card border-0 shadow-sm mb-3" style="border-radius:10px">
    <div class="card-body py-3 px-4">
        <form method="get" asp-action="Manage" class="row g-2 align-items-end">
            <div class="col-md-6">
                <label class="form-label mb-1" style="font-size:.8rem;font-weight:500;color:#595959">Tìm kiếm theo tiêu đề</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white border-end-0" style="border-radius:6px 0 0 6px">
                        <i class="bi bi-search text-muted" style="font-size:.85rem"></i>
                    </span>
                    <input type="text" name="search" value="@search"
                           class="form-control border-start-0" style="border-radius:0 6px 6px 0;font-size:.875rem"
                           placeholder="Nhập tiêu đề bài viết..." />
                </div>
            </div>
            <div class="col-md-auto">
                <button type="submit" class="btn btn-primary btn-sm" style="border-radius:6px;font-size:.875rem;padding:6px 16px">
                    <i class="bi bi-funnel me-1"></i>Lọc
                </button>
                @if (!string.IsNullOrEmpty(search))
                {
                    <a asp-action="Manage" class="btn btn-outline-secondary btn-sm ms-1" style="border-radius:6px;font-size:.875rem;padding:6px 14px">
                        <i class="bi bi-x-lg me-1"></i>Xóa lọc
                    </a>
                }
            </div>
        </form>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert" style="border-radius:8px;font-size:.875rem">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm" role="alert" style="border-radius:8px;font-size:.875rem">
        <i class="bi bi-exclamation-circle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card border-0 shadow-sm" style="border-radius:10px">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size:.875rem">
                <thead style="background:#fafafa;border-bottom:1px solid #f0f0f0">
                    <tr>
                        <th class="px-4 py-3 text-muted fw-500" style="width:60px">#</th>
                        <th class="py-3 text-muted fw-500">Tiêu Đề</th>
                        <th class="py-3 text-muted fw-500" style="width:180px">Cập Nhật Lần Cuối</th>
                        <th class="py-3 text-muted fw-500 text-end pe-4" style="width:160px">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox" style="font-size:2rem;display:block;margin-bottom:8px"></i>
                                Chưa có dữ liệu
                            </td>
                        </tr>
                    }
                    @foreach (var (item, idx) in Model.Select((x, i) => (x, i + 1)))
                    {
                        <tr>
                            <td class="px-4 text-muted">@idx</td>
                            <td class="fw-500" style="color:#262626">@item.Title</td>
                            <td class="text-muted">@item.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-end pe-4">
                                <a asp-action="Article" asp-route-id="@item.AboutId" target="_blank"
                                   class="btn btn-sm btn-outline-primary me-1" style="border-radius:6px;font-size:.8rem;padding:4px 10px" title="Xem">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.AboutId"
                                   class="btn btn-sm btn-outline-warning me-1" style="border-radius:6px;font-size:.8rem;padding:4px 10px" title="Sửa">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.AboutId"
                                   class="btn btn-sm btn-outline-danger" style="border-radius:6px;font-size:.8rem;padding:4px 10px" title="Xóa">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div style="padding:14px 16px;border-top:1px solid #f0f0f0;font-size:.875rem;color:#595959">
            @if (!Model.Any())
            {
                <text>Không có bản ghi nào</text>
            }
            else
            {
                <text>Tổng cộng @Model.Count bản ghi</text>
            }
        </div>
    </div>
</div>
